<%- include('layout', { body: ` 
<!-- Header -->
<section class="bg-gradient-to-br from-orange-500 to-yellow-500 text-white py-12">
    <div class="max-w-4xl mx-auto px-4 text-center">
        <h1 class="text-3xl md:text-4xl font-bold mb-4">Bitcoin Merchants in the Bay Islands</h1>
        <p class="text-lg opacity-90">
            Find businesses that accept Bitcoin and Lightning payments on Roatan &amp; Utila
        </p>
    </div>
</section>

<!-- Merchant List -->
<section class="py-12">
    <div class="max-w-6xl mx-auto px-4">
        ${typeof error !== 'undefined' && error ? `
        <div class="bg-red-100 text-red-700 p-4 rounded-lg mb-8">
            ${error}
        </div>
        ` : ''}
        
        ${typeof merchants !== 'undefined' && merchants.length > 0 ? `
        <div class="mb-6">
            <p class="text-gray-600">
                Found <strong id="merchant-count">${merchants.length}</strong> Bitcoin-accepting merchants across the Bay Islands.
                Data from <a href="https://btcmap.org" target="_blank" class="text-bitcoin hover:underline">BTCMap.org</a>
            </p>
        </div>

        <!-- Filter Tags -->
        ${(() => {
            // Build unique sorted lists of locations and types from merchants
            const locations = [...new Set(merchants.map(m => m.location).filter(Boolean))].sort();
            const types = [...new Set(merchants.map(m => m.type).filter(Boolean))].sort();
            const cap = s => s.charAt(0).toUpperCase() + s.slice(1).replace(/_/g, ' ');
            const pill = (group, value, label) => `
                <button
                    type="button"
                    data-filter-group="${group}"
                    data-filter-value="${value}"
                    class="filter-pill px-3 py-1 rounded-full text-sm border border-gray-300 bg-white text-gray-700 hover:bg-gray-100 transition"
                >${label}</button>`;
            return `
            <div class="mb-8 space-y-3">
                <div>
                    <div class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2">Island</div>
                    <div class="flex flex-wrap gap-2">
                        ${pill('location', 'all', 'All')}
                        ${locations.map(l => pill('location', l, l)).join('')}
                    </div>
                </div>
                <div>
                    <div class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2">Type</div>
                    <div class="flex flex-wrap gap-2">
                        ${pill('type', 'all', 'All')}
                        ${types.map(t => pill('type', t, cap(t))).join('')}
                    </div>
                </div>
            </div>`;
        })()}

        <div id="merchant-grid" class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
            ${merchants.map(m => `
            <div class="merchant-card bg-white rounded-lg shadow-sm p-6 hover:shadow-md transition" data-location="${m.location || ''}" data-type="${m.type || ''}">
                <div class="flex items-start justify-between mb-3">
                    <h3 class="font-bold text-lg">${m.name}</h3>
                    <div class="flex gap-1">
                        ${m.lightning ? '<span class="text-yellow-500" title="Lightning">⚡</span>' : ''}
                        ${m.onchain ? '<span class="text-orange-500" title="On-chain">₿</span>' : ''}
                    </div>
                </div>
                
                <div class="text-sm text-gray-500 mb-3 flex flex-wrap gap-1">
                    <span class="inline-block bg-gray-100 px-2 py-1 rounded">${m.type}</span>
                    ${m.location ? '<span class="inline-block bg-blue-100 text-blue-700 px-2 py-1 rounded">🏝 ' + m.location + '</span>' : ''}
                </div>
                
                ${m.address ? `
                <p class="text-gray-600 text-sm mb-3">
                    📍 ${m.address}
                </p>
                ` : ''}
                
                ${m.phone ? `
                <p class="text-gray-600 text-sm mb-3">
                    📞 <a href="tel:${m.phone}" class="hover:text-bitcoin">${m.phone}</a>
                </p>
                ` : ''}
                
                ${m.website ? `
                <p class="text-sm mb-3">
                    🌐 <a href="${m.website}" target="_blank" class="text-bitcoin hover:underline">Website</a>
                </p>
                ` : ''}
                
                ${m.openingHours ? `
                <p class="text-gray-500 text-xs">
                    🕐 ${m.openingHours}
                </p>
                ` : ''}
                
                <div class="mt-4 pt-4 border-t">
                    <a 
                        href="https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(m.name + ' ' + (m.location || 'Roatan'))}" 
                        target="_blank"
                        class="text-sm text-bitcoin hover:underline"
                    >
                        View on Google Maps →
                    </a>
                </div>
            </div>
            `).join('')}
        </div>

        <div id="merchant-empty" class="text-center py-12 hidden">
            <div class="text-6xl mb-4">🔍</div>
            <h2 class="text-2xl font-bold mb-2">No matches</h2>
            <p class="text-gray-600">Try a different filter combination.</p>
        </div>
        ` : `
        <div class="text-center py-12">
            <div class="text-6xl mb-4">🔍</div>
            <h2 class="text-2xl font-bold mb-4">No Merchants Found</h2>
            <p class="text-gray-600 mb-8">
                We couldn't find any Bitcoin merchants in the Bay Islands right now.
                <br>Check back later or visit <a href="https://btcmap.org" target="_blank" class="text-bitcoin hover:underline">BTCMap.org</a> directly.
            </p>
        </div>
        `}
    </div>
</section>

<!-- Add Your Business -->
<section class="py-12 bg-gray-50">
    <div class="max-w-4xl mx-auto px-4 text-center">
        <h2 class="text-2xl font-bold mb-4">Accept Bitcoin at Your Business?</h2>
        <p class="text-gray-600 mb-6">
            Add your business to BTCMap.org to be listed here and help grow Bitcoin adoption in the Bay Islands!
        </p>
        <a 
            href="https://btcmap.org/add-location" 
            target="_blank"
            class="inline-block bg-bitcoin text-white px-8 py-3 rounded-lg font-bold hover:bg-bitcoin-dark transition"
        >
            Add Your Business to BTCMap
        </a>
    </div>
</section>

<script>
(function() {
    var state = { location: 'all', type: 'all' };
    var activeClasses = ['bg-bitcoin', 'text-white', 'border-bitcoin'];
    var inactiveClasses = ['bg-white', 'text-gray-700', 'border-gray-300'];

    function paint() {
        document.querySelectorAll('.filter-pill').forEach(function(btn) {
            var group = btn.getAttribute('data-filter-group');
            var value = btn.getAttribute('data-filter-value');
            var isActive = state[group] === value;
            activeClasses.forEach(function(c) { btn.classList.toggle(c, isActive); });
            inactiveClasses.forEach(function(c) { btn.classList.toggle(c, !isActive); });
        });
    }

    function apply() {
        var cards = document.querySelectorAll('.merchant-card');
        var visible = 0;
        cards.forEach(function(card) {
            var loc = card.getAttribute('data-location') || '';
            var typ = card.getAttribute('data-type') || '';
            var locMatch = state.location === 'all' || loc === state.location;
            var typMatch = state.type === 'all' || typ === state.type;
            var show = locMatch && typMatch;
            card.classList.toggle('hidden', !show);
            if (show) visible++;
        });
        var countEl = document.getElementById('merchant-count');
        if (countEl) countEl.textContent = visible;
        var empty = document.getElementById('merchant-empty');
        var grid = document.getElementById('merchant-grid');
        if (empty) empty.classList.toggle('hidden', visible !== 0);
        if (grid) grid.classList.toggle('hidden', visible === 0);
    }

    document.querySelectorAll('.filter-pill').forEach(function(btn) {
        btn.addEventListener('click', function() {
            var group = btn.getAttribute('data-filter-group');
            state[group] = btn.getAttribute('data-filter-value');
            paint();
            apply();
        });
    });

    paint();
    apply();
})();
</script>

<!-- CTA -->
<section class="py-12 bg-white">
    <div class="max-w-4xl mx-auto px-4 text-center">
        <h2 class="text-2xl font-bold mb-4">Visited a Merchant?</h2>
        <p class="text-gray-600 mb-6">
            Write a Google review mentioning your Bitcoin payment and enter our raffle!
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="/#register" class="bg-bitcoin text-white px-8 py-3 rounded-lg font-bold hover:bg-bitcoin-dark transition">
                Register for Raffle
            </a>
            <a href="/submit" class="border-2 border-bitcoin text-bitcoin px-8 py-3 rounded-lg font-bold hover:bg-bitcoin hover:text-white transition">
                Submit a Review
            </a>
        </div>
    </div>
</section>
` }) %>
